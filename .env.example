# Copy to `.env` and fill in. `.env` is git-ignored: never commit real values.

# --- Legacy portal this service sits in front of ---
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
# Service account used to log in to the portal (given in the assignment brief)
PORTAL_EMAIL= 
PORTAL_PASSWORD= 
# PORTAL_TIMEOUT_MS=10000
# PORTAL_MAX_RETRIES=2
# PORTAL_MAX_CONCURRENCY=4     # portal requests at once; more wait in a queue
# PORTAL_MAX_QUEUE=200
# PORTAL_BREAKER_THRESHOLD=5    # consecutive failures that open the circuit breaker
# PORTAL_BREAKER_OPEN_MS=30000  # how long it stays open before one trial call

# --- HTTP server ---
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info            # debug | info | warn | error
# CORS_ORIGINS=               # browser origins allowed to call the API, e.g. http://localhost:5173 ("*" = any)
# TRUST_PROXY=0             # set to 1 when running behind nginx / a load balancer

# --- Auth for consumers of THIS API (not the portal) ---
# Comma-separated name:key pairs. Keys must be at least 24 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEYS=tester:<replace-me-with-given-tester-key>
# The server refuses to start without keys. Only for local development:
# AUTH_MODE=disabled

# --- Limits and caching (defaults shown) ---
# RATE_LIMIT_PER_MINUTE=300     # per API key (per IP for public routes)
# CATALOG_TTL_MS=900000         # catalog is fresh for 15 minutes
# CATALOG_MAX_STALE_MS=86400000 # serve stale data for at most 24 hours if the portal is down
# CATALOG_FALLBACK=true        # rebuild from search + detail pages if the signed export breaks
# READINGS_CACHE_ENTRIES=500    # cached (meter, days) readings answers
# READINGS_MAX_STALE_MS=21600000 # serve old readings for at most 6 hours if the portal is down
